ize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="390" y="500" width="230" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;MissedTurnSignalDetector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;깜빡이 누락 (집중잔량과 공유)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Baseline&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;처음 4주 = 평소 · 3주 연속 변화&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;NextStepAdvisor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;만 60세 이상 무료 검사 안내&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="940" y="215" width="230" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;WanderingDetector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;5번 넘게 간 길, 5분 안 재탐색 2번&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="690" y="320" width="230" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;ConditionAdvisor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;해 진 뒤 10km 초과 · 고속도로 휴게소&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="690" y="430" width="230" height="80" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ConditionRecord&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;제안대로 한 횟수 (탓하지 않음)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00AAD2;strokeWidth=2;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="940" y="540" width="230" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;차 안 저장소&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;가족 공유는 본인이 켤 때만 (예정)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=13;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="690" y="540" width="230" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;출발 인사&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;&quot;오늘 어디 가세요?&quot; · 이번 주 기록&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1240" y="95" width="220" height="58" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;주행 중&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;수락하면 회전 200m 앞 깜빡이 알림&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="220" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;변화 안내 · 다음 할 일&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;본인에게 먼저, 길만 열어 둔다&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1240" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;길 헤맴&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;&quot;집으로 안내해 드릴까요?&quot;&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1240" y="325" width="220" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;조건 제안&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;&quot;내일 낮에 가실까요?&quot; 막지 않음&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;fontFamily=Asta Sans,Pretendard,Apple SD Gothic Neo,sans-serif;" vertex="1" parent="1"><mxGeometry x="1240" y="435" width="220" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;가족과 같이 보기&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#4A5A6A'&gt;4주 기록 · 조건 정하기 · 지킨 기록&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=1.5;fontColor=#002C5F;fontSize=14;font